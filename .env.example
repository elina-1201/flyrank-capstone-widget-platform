# --- App ---
PORT=3000
NODE_ENV=development

# --- PostgreSQL (TypeORM) ---
DATABASE_URL=

# --- JWT auth ---
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Public origin (used to build the embed snippet src) ---
PUBLIC_BASE_URL=

# --- Trust proxy (Express `trust proxy`) ---
# Leave empty when the app is exposed directly. Behind a reverse proxy/CDN set
# this so req.ip reflects the real client (X-Forwarded-For) — otherwise per-IP
# rate limiting buckets every visitor together. Accepts true/false, a hop count
# (e.g. 1), or an Express value such as `loopback`.
TRUST_PROXY=

# --- Embed bundle version (filename under public/, e.g. widget.v1.js) ---
WIDGET_BUNDLE_VERSION=v1

# --- SMTP (Mailpit in local dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@example.com
